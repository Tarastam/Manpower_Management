@page
@model ManpowerManagement.Pages.Attendance.PregnantModel
@using System.Globalization
@using System.Text.Json
@using ManpowerManagement.Models
@using ManpowerManagement.Pages.Attendance
@{
    ViewData["Title"] = "Attendance - Pregnant";
    var today = ManpowerManagement.Services.BusinessDateService.Current();
    var prevMonth = Model.MonthStart.AddMonths(-1).ToString("yyyy-MM");
    var nextMonth = Model.MonthStart.AddMonths(1).ToString("yyyy-MM");
    var gridData = new
    {
        today = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        month = Model.Month,
        shift = "",
        standardHours = PregnantModel.StandardHours,
        maxWeeklyHours = PregnantModel.MaxWeeklyHours,
        workshopId = 0,
        manpower = false,
        isAdmin = User.IsInRole(Roles.Admin),
        canEditPast = true,
        leaveCodes = IndexModel.LeaveCodes.ToDictionary(p => ((int)p.Key).ToString(), p => p.Value),
        workshops = Model.TransferOptions.ToDictionary(o => o.Value, o => o.Text),
        days = Model.Days.Select(d => new
        {
            date = d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            day = d.Day,
            dow = d.ToString("ddd", CultureInfo.InvariantCulture),
            inMonth = d.Month == Model.MonthStart.Month,
            off = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday,
            direct = (int?)null,
            indirect = (int?)null,
            ind = (int[]?)null,
            counted = false
        }),
        rows = Model.GridRows.Select(r => new
        {
            id = r.EmployeeId,
            code = r.EmployeeCode,
            name = r.EmployeeName,
            process = r.Process,
            leader = false,
            home = Model.HomeWorkshops[r.EmployeeId],
            cells = r.Cells.Select(c => new { h = c.WorkingHours, lt = (int)c.LeaveType, lh = c.LeaveHours, w = c.WorkshopId, rs = false, n = c.Note })
        })
    };
}

<div class="attendance-page ag-page pregnant-page">
    <div class="attendance-heading">
        <div><span class="attendance-eyebrow">WORKFORCE SCHEDULE</span><h1>Attendance</h1><p>Pregnant employees count @PregnantModel.StandardHours.ToString("0.00") hrs Monday to Friday; Saturday and Sunday are OFF. Their hours are counted as indirect hours. Key only the exceptions, the same way as By Shift. Changes are saved automatically and written to the database at 07:00 and 19:00.</p></div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link" asp-page="/Attendance/Index">By Shift</a></li>
        <li class="nav-item"><a class="nav-link active" asp-page="/Attendance/Pregnant">Pregnant</a></li>
    </ul>

    @if (Model.GroupMissing)
    {
        <div class="alert alert-warning">No "Pregnant" special group exists yet. Create one on the <a asp-page="/SpecialGroups/Index">Special Groups</a> page (Admin) and tag employees there before they appear here.</div>
    }

    <div class="ag-monthbar pregnant-monthbar">
        <a class="btn ag-icon-btn" asp-route-month="@prevMonth" asp-route-workshopId="@Model.WorkshopId" aria-label="Previous month" data-nav>◀</a>
        <h2>@Model.MonthStart.ToString("MMMM yyyy")</h2>
        <a class="btn ag-icon-btn" asp-route-month="@nextMonth" asp-route-workshopId="@Model.WorkshopId" aria-label="Next month" data-nav>▶</a>
        <span class="ag-monthbar-meta">@Model.GridRows.Count employees · Monday–Friday schedule · @PregnantModel.StandardHours.ToString("0.00") hrs/day</span>
        <form class="pregnant-month-picker ms-auto" method="get">
            <input type="hidden" name="month" value="@Model.Month" />
            <label class="visually-hidden" for="workshopFilter">Select workshop</label>
            <select id="workshopFilter" class="form-select" name="WorkshopId" aria-label="Select workshop" data-nav-select onchange="this.form.requestSubmit()">
                <option value="">All workshops</option>
                @foreach (var option in Model.WorkshopOptions) { <option value="@option.Value" selected="@(option.Value == Model.WorkshopId?.ToString())">@option.Text</option> }
            </select>
        </form>
    </div>

    @if (Model.GridRows.Any())
    {
        <div class="ag-toolbar">
            <div class="attendance-search">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <label class="visually-hidden" for="agSearch">Search employee</label><input id="agSearch" type="search" placeholder="Search employee" autocomplete="off" />
            </div>
            <div class="ag-fill" role="group" aria-label="Fill selected cells">
                <span class="ag-fill-label">Fill selection:</span>
                <button type="button" class="ag-chip" data-fill="">@PregnantModel.StandardHours.ToString("0.00")</button>
                @foreach (var code in IndexModel.LeaveCodes)
                {
                    <button type="button" class="ag-chip lt-@((int)code.Key)" data-fill="@code.Value" title="@code.Key">@code.Value</button>
                }
                <button type="button" class="ag-chip" id="agTransfer" title="Record work in another workshop">Transfer…</button>
            </div>
            <button type="button" class="btn ag-tool-btn" id="agNote" title="Add or edit a note on the selected cell (Shift+F2)">Note…</button>
            <button type="button" class="btn ag-tool-btn" id="agToday">Today</button>
        </div>

        <details class="ag-help">
            <summary>How to key attendance</summary>
            <ul>
                <li><strong>Type into a cell</strong>: a number (e.g. <code>6</code>) for working hours. A leave code for a full day: <code>AL</code> Annual, <code>SL</code> Sick, <code>BL</code> Business, <code>OL</code> Other, <code>AB</code> Absent, <code>ML</code> Mother. A code plus hours for part of the day, e.g. <code>SL4</code> = 4 hrs sick leave, 4 hrs worked.</li>
                <li><strong>Move</strong> with the arrow keys, Tab or Enter. <strong>Delete</strong> resets a cell to @PregnantModel.StandardHours.ToString("0.00") (or OFF). Drag or Shift+click to select several cells, then type and press <kbd>Ctrl</kbd>+<kbd>Enter</kbd> to fill them all.</li>
                <li><strong>ML</strong>: click the <strong>ML</strong> chip, or type <code>ML</code> and press Enter, to choose the Mother Leave date range. It is saved for every Monday–Friday in the range, including dates outside the displayed month.</li>
                <li><strong>Transfer</strong> records that the day was worked in another workshop (the cell turns green). <strong>Notes</strong> work like Excel's Add note: select a cell and press <kbd>Shift</kbd>+<kbd>F2</kbd> (or click <strong>Note…</strong>); cells with a note show a red corner, hover to read it.</li>
                <li><strong>Copy &amp; paste from Excel</strong>: select a cell and press <kbd>Ctrl</kbd>+<kbd>V</kbd>. Pasting one value into a selected range fills the whole range.</li>
                <li>OFF days (hatched) accept OT hours only. Future dates accept leave only. There is no Submit button: every change is saved as you type and copied to the database at 07:00 and 19:00.</li>
            </ul>
        </details>

        <div class="ag-wrap" id="agWrap" tabindex="0" aria-label="Attendance grid. Use the arrow keys to move and type to edit.">
            <table class="ag-grid" id="agGrid"></table>
            <input id="agEditor" class="ag-editor" autocomplete="off" spellcheck="false" hidden />
        </div>
        <div class="ag-status" id="agStatus" aria-live="polite"></div>

        @Html.AntiForgeryToken()
        <div class="ag-submit">
            <span class="ag-dirty" id="agDirty" role="status" aria-live="polite" hidden></span>
            <span class="text-muted small">Saved changes are written to the database at 07:00 and 19:00. Until then they show here but not on the dashboard.</span>
        </div>
    }
    else if (!Model.GroupMissing)
    {
        <div class="alert alert-info">@(Model.WorkshopId is null ? "No active employees are tagged as \"Pregnant\" yet." : "No pregnant employees in the selected workshop.")</div>
    }
</div>

<div class="modal fade" id="agTransferModal" tabindex="-1" aria-labelledby="agTransferTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="agTransferTitle">Transfer to another workshop</h2><p class="mb-0 small text-muted" id="agTransferContext"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><label class="form-label" for="agTransferWorkshop">Worked in</label><select id="agTransferWorkshop" class="form-select" asp-items="Model.TransferOptions"></select><p class="small text-muted mt-2 mb-0">The selected cells keep their hours and leave. Only the workshop the hours are counted in changes.</p></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="agTransferApply">Apply</button></div>
</div></div></div>

<div class="modal fade" id="agNoteModal" tabindex="-1" aria-labelledby="agNoteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="agNoteTitle">Note</h2><p class="mb-0 small text-muted" id="agNoteContext"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
        <label class="visually-hidden" for="agNoteText">Note</label>
        <textarea id="agNoteText" class="form-control" rows="4" maxlength="@AttendanceNote.MaxLength" placeholder="e.g. Annual leave booked for 13 May, moved to Pellet Ass'y"></textarea>
        <div class="d-flex justify-content-between small text-muted mt-1"><span>Enter saves · Shift+Enter new line</span><span id="agNoteCount">0/@AttendanceNote.MaxLength</span></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-danger me-auto" id="agNoteDelete" hidden>Delete note</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="agNoteSave">Save</button></div>
</div></div></div>

<div class="modal fade" id="agMlModal" tabindex="-1" aria-labelledby="agMlTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="agMlTitle">Mother Leave · ML</h2><p class="mb-0 small text-muted">Choose the employee and the leave period.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
        <div class="mb-3"><label class="form-label" for="agMlEmployee">Employee</label><select class="form-select" id="agMlEmployee">@foreach (var row in Model.GridRows) { <option value="@row.EmployeeId">@row.EmployeeCode · @row.EmployeeName</option> }</select></div>
        <div class="mother-range"><div><label class="form-label" for="agMlStart">From</label><input class="form-control" id="agMlStart" type="date" /></div><div><label class="form-label" for="agMlEnd">To</label><input class="form-control" id="agMlEnd" type="date" /></div><p>ML is saved for every Monday–Friday in this period, including dates outside the displayed month. Saturday and Sunday stay OFF. You can select a range of up to 10 years.</p></div>
        <div id="agMlError" class="alert alert-danger py-2 mt-3 mb-0 small" role="alert" hidden></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="agMlSave">Save ML</button></div>
</div></div></div>

@section Scripts {
<script id="agData" type="application/json">@Html.Raw(JsonSerializer.Serialize(gridData))</script>
<script src="~/js/attendance-grid.js" asp-append-version="true"></script>
}
