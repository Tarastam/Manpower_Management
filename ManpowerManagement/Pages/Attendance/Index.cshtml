@page
@model ManpowerManagement.Pages.Attendance.IndexModel
@using System.Globalization
@using System.Text.Json
@using ManpowerManagement.Models
@using ManpowerManagement.Pages.Attendance
@{
    ViewData["Title"] = "Attendance";
    var today = ManpowerManagement.Services.BusinessDateService.Current();
    var prevMonth = Model.MonthStart.AddMonths(-1).ToString("yyyy-MM");
    var nextMonth = Model.MonthStart.AddMonths(1).ToString("yyyy-MM");
    var leader = Model.Leader;
    var gridData = new
    {
        today = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        month = Model.Month,
        shift = Model.Shift,
        standardHours = IndexModel.StandardHours,
        maxWeeklyHours = IndexModel.MaxWeeklyHours,
        workshopId = Model.WorkshopId ?? 0,
        isAdmin = Model.IsAdmin,
        canEditPast = true,
        leaveCodes = IndexModel.LeaveCodes.ToDictionary(p => ((int)p.Key).ToString(), p => p.Value),
        workshops = Model.WorkshopOptions.ToDictionary(o => o.Value, o => o.Text),
        days = Model.Days.Select(d => new
        {
            date = d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            day = d.Day,
            dow = d.ToString("ddd", CultureInfo.InvariantCulture),
            inMonth = d.Month == Model.MonthStart.Month,
            off = Model.OffDays.Contains(d),
            direct = Model.Manpower.TryGetValue(d, out var m) && m.Keyed ? m.DirectCount : null,
            indirect = Model.Manpower.TryGetValue(d, out var n) && n.Keyed ? n.IndirectCount : null,
            ind = Model.Manpower.TryGetValue(d, out var b) && b.Keyed ? new[] { b.I1067, b.I841, b.I733 } : null,
            // Closed days already counted by the daily summary.
            counted = Model.Manpower.TryGetValue(d, out var c) && c.TotalHours.HasValue
        }),
        rows = Model.GridRows.Select(r => new
        {
            id = r.EmployeeId,
            code = r.EmployeeCode,
            name = r.EmployeeName,
            process = r.Process,
            leader = r.IsLeader,
            cells = r.Cells.Select(c => new { h = c.WorkingHours, lt = (int)c.LeaveType, lh = c.LeaveHours, w = c.WorkshopId, rs = c.IsResigned })
        })
    };
}

<div class="attendance-page ag-page">
    <div class="attendance-heading">
        <div><span class="attendance-eyebrow">WORKFORCE SCHEDULE</span><h1>Attendance</h1><p>Every working day counts @IndexModel.StandardHours.ToString("0.00") hrs for everyone from the start of the day. Key only the exceptions, the same way as in the Excel sheet. Changes are saved automatically and written to the database at 07:00 and 19:00.</p></div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link active" asp-page="/Attendance/Index">By Shift</a></li>
        <li class="nav-item"><a class="nav-link" asp-page="/Attendance/Pregnant">Pregnant</a></li>
    </ul>

    @if (leader is not null)
    {
        <div class="ag-scope" role="status">
            <div class="ag-scope-main">
                <span class="ag-scope-label">Entering attendance for</span>
                @if (Model.CanSwitchShift)
                {
                    <form method="get" class="ag-scope-shift">
                        <strong class="ag-scope-team">@leader.WorkshopName <span>·</span></strong>
                        <input type="hidden" name="month" value="@Model.Month" />
                        <label class="visually-hidden" for="scopeWorkshop">Workshop</label>
                        <select id="scopeWorkshop" name="workshopId" class="form-select" data-nav-select onchange="this.form.shift.value = ''; this.form.requestSubmit()">
                            @foreach (var w in Model.AllowedWorkshops) { <option value="@w.Value" selected="@(w.Value == Model.WorkshopId?.ToString())">@w.Text</option> }
                        </select>
                        <label class="visually-hidden" for="scopeShift">Shift</label>
                        <select id="scopeShift" name="shift" class="form-select" data-nav-select onchange="this.form.requestSubmit()">
                            @foreach (var s in Model.AllowedShifts) { <option value="@s" selected="@(s == Model.Shift)">Shift @s</option> }
                        </select>
                    </form>
                    <span class="ag-scope-by">Keyed by @leader.Name (@leader.EmployeeCode) · all workshops and shifts in this line</span>
                }
                else
                {
                    <strong class="ag-scope-team">@leader.WorkshopName <span>·</span> Shift @Model.Shift</strong>
                }
                @if (!Model.CanSwitchShift) { <span class="ag-scope-by">Keyed by @leader.Name (@leader.EmployeeCode)</span> }
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <form method="post" asp-page="/Attendance/CheckIn" asp-page-handler="Lookup"><input type="hidden" name="EmployeeCode" value="@leader.EmployeeCode" /><button class="btn btn-light">Change workshop / shift</button></form>
                <form method="post" asp-page="/Attendance/CheckIn" asp-page-handler="SignOut"><button class="btn btn-light">Change leader</button></form>
            </div>
        </div>
    }
    else
    {
        <form class="ag-admin-filters" method="get">
            <span class="ag-admin-badge">Admin</span>
            <div><label class="form-label" for="workshop">Workshop</label><select id="workshop" class="form-select" asp-for="WorkshopId" asp-items="Model.WorkshopOptions" onchange="this.form.submit()"><option value="">Select workshop</option></select></div>
            <div><label class="form-label" for="shift">Shift</label><select id="shift" class="form-select" asp-for="Shift" asp-items="Model.ShiftOptions" onchange="this.form.submit()"><option value="">Select shift</option></select></div>
            <input type="hidden" asp-for="Month" />
            <a class="btn btn-outline-secondary ms-auto" asp-page="/Attendance/CheckIn">Leader check-in</a>
        </form>
    }

    @if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }
    @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error <span class="small">Your unsaved edits are still shown below.</span></div> }

    @if (Model.HasScope)
    {
        <div class="ag-monthbar">
            <a class="btn ag-icon-btn" asp-route-month="@prevMonth" asp-route-workshopId="@Model.WorkshopId" asp-route-shift="@(leader is null || Model.CanSwitchShift ? Model.Shift : null)" aria-label="Previous month" data-nav>◀</a>
            <h2>@Model.MonthStart.ToString("MMMM yyyy")</h2>
            <a class="btn ag-icon-btn" asp-route-month="@nextMonth" asp-route-workshopId="@Model.WorkshopId" asp-route-shift="@(leader is null || Model.CanSwitchShift ? Model.Shift : null)" aria-label="Next month" data-nav>▶</a>
            <span class="ag-monthbar-meta">@Model.GridRows.Count employees · @Model.WorkshopName · Shift @Model.Shift </span>
            <a class="btn ag-tool-btn ms-auto" asp-page-handler="ExportCsv" asp-route-month="@Model.Month" asp-route-workshopId="@Model.WorkshopId" asp-route-shift="@(leader is null || Model.CanSwitchShift ? Model.Shift : null)">Export CSV</a>
        </div>

        @if (Model.GridRows.Any())
        {
            <div class="ag-toolbar">
                <div class="attendance-search">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <label class="visually-hidden" for="agSearch">Search employee</label><input id="agSearch" type="search" placeholder="Search employee" autocomplete="off" />
                </div>
                <div class="ag-fill" role="group" aria-label="Fill selected cells">
                    <span class="ag-fill-label">Fill selection:</span>
                    <button type="button" class="ag-chip" data-fill="">@IndexModel.StandardHours.ToString("0.00")</button>
                    @foreach (var code in IndexModel.LeaveCodes)
                    {
                        <button type="button" class="ag-chip lt-@((int)code.Key)" data-fill="@code.Value" title="@code.Key">@code.Value</button>
                    }
                    <button type="button" class="ag-chip" id="agTransfer" title="Record work in another workshop">Transfer…</button>
                </div>
                <button type="button" class="btn ag-tool-btn" id="agToday">Today</button>
            </div>

            <details class="ag-help">
                <summary>How to key attendance</summary>
                <ul>
                    <li><strong>Type into a cell</strong>: a number (e.g. <code>7.33</code>) for working hours. A leave code for a full day: <code>AL</code> Annual, <code>SL</code> Sick, <code>BL</code> Business, <code>OL</code> Other, <code>AB</code> Absent, <code>ML</code> Mother. A code plus hours for part of the day, e.g. <code>SL4</code> = 4 hrs sick leave, 6.67 hrs worked.</li>
                    <li><strong>Move</strong> with the arrow keys, Tab or Enter. <strong>Delete</strong> resets a cell to @IndexModel.StandardHours.ToString("0.00") (or OFF). Drag or Shift+click to select several cells, then type and press <kbd>Ctrl</kbd>+<kbd>Enter</kbd> to fill them all.</li>
                    <li><strong>Copy &amp; paste from Excel</strong>: select a cell and press <kbd>Ctrl</kbd>+<kbd>V</kbd>. Pasting one value into a selected range fills the whole range.</li>
                    <li>OFF days (hatched) accept OT hours only. Future dates accept leave only, so leave can be keyed in advance. There is no Submit button: every change is saved as you type and copied to the database at 07:00 and 19:00.</li>
                    <li>Click <strong>Indirect MP</strong> at the bottom of each day and enter the number of indirect people for each working-hour band (10.67 / 8.41 / 7.33). <strong>Direct</strong> = present − indirect, calculated automatically. The daily hour summary uses Total Hours − Indirect Hours for productivity.</li>
                    <li>Employees marked <span class="ag-leader-tag">LDR</span> are on the Attendance Leader list. Their attendance hours are included in Total Hours and deducted as Indirect Hours in the daily summary.</li>
                </ul>
            </details>

            <div class="ag-wrap" id="agWrap" tabindex="0" aria-label="Attendance grid. Use the arrow keys to move and type to edit.">
                <table class="ag-grid" id="agGrid"></table>
                <input id="agEditor" class="ag-editor" autocomplete="off" spellcheck="false" hidden />
            </div>
            <div class="ag-status" id="agStatus" aria-live="polite"></div>

            @Html.AntiForgeryToken()
            <div class="ag-submit">
                <span class="ag-dirty" id="agDirty" role="status" aria-live="polite" hidden></span>
                <span class="text-muted small">Saved changes are written to the database at 07:00 and 19:00. Until then they show here but not on the dashboard.</span>
            </div>

            @if (Model.IsAdmin && Model.Manpower.Any(x => x.Value.TotalHours.HasValue))
            {
                <section class="mt-4" aria-labelledby="dailyHoursTitle">
                    <h3 class="h5" id="dailyHoursTitle">Daily working hours</h3>
                    <p class="text-muted small">Direct Hours = Total Hours − Indirect Hours. Indirect starts from the hour-band counts and leader hours; correct the daily total here when actual hours differ.</p>
                    <div class="table-responsive"><table class="table table-sm align-middle">
                        <thead><tr><th>Date</th><th>Total Hours</th><th>Indirect Hours</th><th>Direct Hours</th><th>Source</th><th>Correction</th></tr></thead>
                        <tbody>
                        @foreach (var (day, summary) in Model.Manpower.Where(x => x.Value.TotalHours.HasValue).OrderBy(x => x.Key))
                        {
                            <tr>
                                <td>@day.ToString("dd MMM yyyy")</td>
                                <td>@summary.TotalHours?.ToString("N2")</td>
                                <td>@summary.IndirectHours?.ToString("N2")</td>
                                <td class="fw-semibold @(summary.DirectHours < 0 ? "text-danger" : "")">@summary.DirectHours?.ToString("N2")</td>
                                <td>@(summary.IndirectHoursIsManual ? "Corrected" : "Calculated")</td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <form method="post" asp-page-handler="IndirectHours" class="d-flex gap-1">
                                            <input type="hidden" name="WorkshopId" value="@Model.WorkshopId" /><input type="hidden" name="Shift" value="@Model.Shift" />
                                            <input type="hidden" name="businessDate" value="@day.ToString("yyyy-MM-dd")" />
                                            <input class="form-control form-control-sm" style="width:7rem" type="number" name="indirectHours" min="0" max="@summary.TotalHours" step="0.01" value="@summary.IndirectHours" aria-label="Indirect hours for @day.ToString("dd MMM yyyy")" required />
                                            <button class="btn btn-outline-primary btn-sm">Save</button>
                                        </form>
                                        @if (summary.IndirectHoursIsManual)
                                        {
                                            <form method="post" asp-page-handler="ResetIndirectHours">
                                                <input type="hidden" name="WorkshopId" value="@Model.WorkshopId" /><input type="hidden" name="Shift" value="@Model.Shift" />
                                                <input type="hidden" name="businessDate" value="@day.ToString("yyyy-MM-dd")" />
                                                <button class="btn btn-outline-secondary btn-sm">Reset</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                </section>
            }
        }
        else
        {
            <div class="alert alert-warning">No active employees in @Model.WorkshopName, shift @Model.Shift.</div>
        }
    }
</div>

<div class="modal fade" id="agTransferModal" tabindex="-1" aria-labelledby="agTransferTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="agTransferTitle">Transfer to another workshop</h2><p class="mb-0 small text-muted" id="agTransferContext"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><label class="form-label" for="agTransferWorkshop">Worked in</label><select id="agTransferWorkshop" class="form-select" asp-items="Model.WorkshopOptions"></select><p class="small text-muted mt-2 mb-0">The selected cells keep their hours and leave. Only the workshop the hours are counted in changes.</p></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="agTransferApply">Apply</button></div>
</div></div></div>

<div class="modal fade" id="agIndirectModal" tabindex="-1" aria-labelledby="agIndirectTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title fs-5" id="agIndirectTitle">Indirect manpower</h2><p class="mb-0 small text-muted" id="agIndirectContext"></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
        <table class="table table-sm align-middle mb-2"><thead><tr><th>Working hours</th><th>Headcount</th></tr></thead><tbody>
            <tr><td>10.67</td><td><input class="form-control form-control-sm ag-ind" data-b="0" inputmode="numeric" maxlength="4" aria-label="Headcount 10.67 hours" /></td></tr>
            <tr><td>8.41</td><td><input class="form-control form-control-sm ag-ind" data-b="1" inputmode="numeric" maxlength="4" aria-label="Headcount 8.41 hours" /></td></tr>
            <tr><td>7.33</td><td><input class="form-control form-control-sm ag-ind" data-b="2" inputmode="numeric" maxlength="4" aria-label="Headcount 7.33 hours" /></td></tr>
        </tbody></table>
        <div class="small" id="agIndirectCalc"></div>
        <div id="agIndirectError" class="alert alert-danger py-2 mt-2 mb-0 small" hidden></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="agIndirectApply">Apply</button></div>
</div></div></div>

@section Scripts {
<script id="agData" type="application/json">@Html.Raw(JsonSerializer.Serialize(gridData))</script>
<script src="~/js/attendance-grid.js" asp-append-version="true"></script>
}
