@page
@model IndexModel
@using System.Globalization
@using System.Text.Json
@using ManpowerManagement.Models
@using ManpowerManagement.Services
@{
    ViewData["Title"] = "Workforce overview";
    var report = Model.Report;
    var mp = report.Manpower;
    var monthLabel = DateTime.ParseExact(report.Month, "yyyy-MM", CultureInfo.InvariantCulture).ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    var periodNote = report.PeriodEnd == DateOnly.Parse(report.Month + "-01") && mp.Period == WorkforceDashboardService.Mtd
        ? "No reporting days yet"
        : (mp.Period == WorkforceDashboardService.Mtd ? "" : mp.PeriodLabel + " · ") + "Data through " + report.PeriodEnd.AddDays(-1).ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    var periodLabel = mp.Period == WorkforceDashboardService.Mtd ? "MTD" : mp.PeriodLabel;
    var workshopData = JsonSerializer.Serialize(report.Workshops.Select(x => new { id = x.Id, name = x.Name, parentId = x.ParentId }));
}
<div class="workforce-dashboard">
    <div class="wd-heading">
        <div>
            <h1>Workforce overview</h1>
            <p>@monthLabel · @(mp.Period == WorkforceDashboardService.Mtd ? "MTD" : mp.PeriodLabel) · @report.WorkshopLabel</p>
        </div>
    </div>

    <form class="wd-filters" method="get">
        <div class="wd-filter-field wd-month">
            <label for="dashboard-month">Month</label>
            <input id="dashboard-month" type="month" name="month" value="@report.Month" />
        </div>
        <div class="wd-workshop-picker" id="dashboard-workshop-picker">
            <div class="wd-filter-field wd-workshop">
                <span class="wd-filter-label" id="dashboard-workshop-label">Workshop</span>
                <button id="dashboard-workshop" class="wd-workshop-trigger" type="button" aria-labelledby="dashboard-workshop-label dashboard-workshop-value" aria-haspopup="dialog" aria-expanded="false" aria-controls="dashboard-workshop-popover">
                    <span id="dashboard-workshop-value">@(report.WorkshopId is null ? "All workshops" : report.WorkshopLabel)</span>
                    <span class="wd-chevron-down" aria-hidden="true"></span>
                </button>
            </div>
            <input type="hidden" id="dashboard-workshop-id" name="workshopId" value="@report.WorkshopId" />
            <div class="wd-workshop-popover" id="dashboard-workshop-popover" role="dialog" aria-label="Choose workshop" hidden>
                <div class="wd-workshop-search-wrap">
                    <label class="visually-hidden" for="dashboard-workshop-search">Search workshops</label>
                    <input id="dashboard-workshop-search" type="search" placeholder="Search workshops..." autocomplete="off" />
                </div>
                <div class="wd-workshop-level" id="dashboard-workshop-level"></div>
                <div class="wd-workshop-results" id="dashboard-workshop-results" aria-live="polite"></div>
            </div>
        </div>
        <div class="wd-filter-field wd-period">
            <label for="dashboard-period">Period</label>
            <select id="dashboard-period" name="period">
                @foreach (var option in mp.Periods)
                {
                    <option value="@option.Key" selected="@(option.Key == mp.Period)" disabled="@(!option.Available)">@option.Label (@option.Range)</option>
                }
            </select>
        </div>
        <button class="wd-apply" type="submit">Apply filters</button>
        <p class="wd-period-note">@periodNote</p>
    </form>

    <section class="wd-kpis" aria-label="Key workforce metrics">
        <article class="wd-card wd-kpi">
            <span class="wd-kpi-icon wd-icon-blue" aria-hidden="true">●</span>
            <div><h2>Active headcount</h2><strong>@report.Headcount.ToString("N0")</strong></div>
        </article>
        <article class="wd-card wd-kpi">
            <span class="wd-kpi-icon wd-icon-blue" aria-hidden="true">✓</span>
            <div><h2>Attendance rate (@periodLabel)</h2><strong>@(report.ScheduledPersonDays == 0 ? "—" : report.AttendanceRate.ToString("N1") + "%")</strong><p>People present / scheduled headcount days</p></div>
        </article>
        <article class="wd-card wd-kpi">
            <span class="wd-kpi-icon wd-icon-amber" aria-hidden="true">!</span>
            <div><h2>Absence rate (@periodLabel)</h2><strong>@(report.ScheduledPersonDays == 0 ? "—" : report.AbsenceRate.ToString("N1") + "%")</strong><p>Absent person-days / scheduled headcount days</p></div>
        </article>
        <article class="wd-card wd-kpi">
            <span class="wd-kpi-icon wd-icon-blue" aria-hidden="true">↻</span>
            <div><h2>Turnover rate (@periodLabel)</h2><strong>@report.TurnoverRate.ToString("N1")%</strong></div>
        </article>
    </section>

    <div class="wd-content-grid">
        <div class="wd-main-panels">
            <partial name="_ManpowerTables" model="mp" />
        </div>

        <div class="wd-side-panels">
            <section class="wd-card wd-leave-chart" aria-labelledby="leave-chart-title">
                <div class="wd-panel-heading"><div><h2 id="leave-chart-title">Leave ratio</h2><p>Average of daily % of manpower on leave · @periodLabel</p></div></div>
                @{
                    var maxRatio = Model.LeaveRatios.Max(x => x.Ratio);
                }
                <div class="wd-bars">
                    @foreach (var row in Model.LeaveRatios)
                    {
                        var width = maxRatio == 0 ? 0 : row.Ratio / maxRatio * 100m;
                        <div class="wd-bar-row@(row.IsTotal ? " wd-bar-total" : "")"><span>@row.Name</span><div class="wd-bar-track" role="img" aria-label="@row.Name: @row.Ratio.ToString("P2") of manpower"><span style="width:@width.ToString("0.##", CultureInfo.InvariantCulture)%"></span></div><strong>@row.Ratio.ToString("P2")</strong></div>
                    }
                </div>
                <p class="wd-method-note">Same figure as the Absent Ratio report: people on each leave type ÷ all A, B and C shift manpower per day, averaged over the days of the chosen period (up to today). Day shift and the Pregnant group are not counted.</p>
            </section>

            <section class="wd-card wd-high-leave" aria-labelledby="high-leave-title">
                <div class="wd-panel-heading">
                    <div><h2 id="high-leave-title">High leave rate by workshop</h2><p>Employees with a leave rate above 5% · @periodLabel</p></div>
                    <span class="wd-alert-count">@report.HighLeaveEmployees.Count.ToString("N0") employees need review</span>
                </div>
                <div class="wd-table-wrap wd-high-leave-scroll" tabindex="0" role="region" aria-label="High leave rate by workshop, scrollable">
                    <table class="wd-table">
                        <thead><tr><th scope="col">Workshop</th><th scope="col">Above 5%</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                        @if (report.WorkshopRows.Count == 0)
                        {
                            <tr><td colspan="3" class="wd-empty">No employees exceed the 5% leave threshold for this selection.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in report.WorkshopRows)
                            {
                                <tr><td class="wd-workshop-name" title="@row.Name">@row.Name</td><td><strong>@row.Count.ToString("N0")</strong></td><td><a asp-page="/HighLeave" asp-route-month="@report.Month" asp-route-period="@mp.Period" asp-route-workshopId="@row.Id">View <span aria-hidden="true">→</span><span class="visually-hidden"> employees in @row.Name</span></a></td></tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                <p class="wd-method-note">@(report.WorkshopRows.Count > 5 ? $"Top 5 of {report.WorkshopRows.Count} workshops shown; scroll for the rest. " : "")Leave rate = confirmed leave hours ÷ scheduled hours for each employee.</p>
            </section>

            <section class="wd-card wd-high-leave wd-resigned" aria-labelledby="resigned-title">
                <div class="wd-panel-heading">
                    <div><h2 id="resigned-title">Resigned employees</h2><p>Last working day in @monthLabel (whole month, not affected by the period)</p></div>
                    <span class="wd-alert-count">@report.ResignedEmployees.Count.ToString("N0") resigned</span>
                </div>
                <div class="wd-table-wrap wd-high-leave-scroll" tabindex="0" role="region" aria-label="Resigned employees, scrollable">
                    <table class="wd-table">
                        <thead><tr><th scope="col">Emp ID</th><th scope="col">Name</th><th scope="col">Workshop</th><th scope="col">Resigned Date</th></tr></thead>
                        <tbody>
                        @if (report.ResignedEmployees.Count == 0)
                        {
                            <tr><td colspan="4" class="wd-empty">No resignations in this period for this selection.</td></tr>
                        }
                        else
                        {
                            @foreach (var person in report.ResignedEmployees)
                            {
                                <tr><td>@person.Code</td><td class="wd-resigned-name" title="@person.Name">@person.Name</td><td class="wd-resigned-name" title="@person.Workshop">@person.Workshop</td><td class="wd-nowrap">@person.ResignedDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td></tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                <p class="wd-method-note">@(report.ResignedEmployees.Count > 5 ? $"Latest 5 of {report.ResignedEmployees.Count} shown; scroll for the rest. " : "")Follows the month and workshop filters above, but not the period.</p>
            </section>

            <section class="wd-card wd-actions" aria-labelledby="actions-title">
                <h2 id="actions-title">Quick actions</h2>
                <a asp-page="/Attendance/Index"><span>Open attendance</span><span aria-hidden="true">→</span></a>
                <a asp-page="/Employees/Index"><span>View employees</span><span aria-hidden="true">→</span></a>
                <a asp-page="/NewHires/Index"><span>New hire monitoring</span><span aria-hidden="true">→</span></a>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Approver))
                {
                    <a asp-page="/Tickets/Manage"><span>Manage tickets</span><span aria-hidden="true">→</span></a>
                }
                else
                {
                    <a asp-page="/Tickets/Create"><span>Create resignation ticket</span><span aria-hidden="true">→</span></a>
                }
            </section>
        </div>
    </div>
</div>
<script type="application/json" id="dashboard-workshop-data">@Html.Raw(workshopData)</script>
@section Scripts {
    <script src="~/js/workshop-filter.js" asp-append-version="true"></script>
}
