@page
@model ManpowerManagement.Pages.Admin.NewHireRulesModel
@{
    ViewData["Title"] = "Early-warning rules";
}
<div class="wd-detail">
    <a class="wd-back" asp-page="/NewHires/Index">← Back to new hires</a>
    <div class="wd-heading"><div><h1>Early-warning rules</h1><p>When the system flags a new hire</p></div></div>
    @if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
    @if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

    <section class="wd-card nh-panel" aria-labelledby="rules-title">
        <div class="wd-panel-heading"><div><h2 id="rules-title">Early-warning rules</h2><p>New hires meeting any rule are flagged "at risk". Probation: decide before day 60, extend up to day 119.</p></div></div>
        <form method="post" class="row g-3">
            <div class="col-md-3"><label class="form-label" asp-for="Rules.ConsecutiveAbsentDays">Absent days in a row</label><input class="form-control" type="number" min="1" max="30" asp-for="Rules.ConsecutiveAbsentDays" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="Rules.NoShowDays">No-show: first scheduled days</label><input class="form-control" type="number" min="1" max="30" asp-for="Rules.NoShowDays" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="Rules.LeaveRatePercent">Leave rate above (%)</label><input class="form-control" type="number" step="0.1" min="0.1" max="100" asp-for="Rules.LeaveRatePercent" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="Rules.LeaveRateWindowDays">…within the last (days)</label><input class="form-control" type="number" min="3" max="60" asp-for="Rules.LeaveRateWindowDays" /></div>
            <div class="col-md-3"><label class="form-label" asp-for="Rules.DecisionWarningDay">Warn about the decision from day</label><input class="form-control" type="number" min="1" max="59" asp-for="Rules.DecisionWarningDay" /></div>
            <div class="col-12"><input type="hidden" asp-for="Rules.Id" /><button class="btn btn-success">Save rules</button></div>
        </form>
    </section>
</div>
