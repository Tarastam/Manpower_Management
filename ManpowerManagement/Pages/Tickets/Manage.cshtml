@page
@model ManpowerManagement.Pages.Tickets.ManageModel
@{ViewData["Title"]="Ticket Approval";}
<h1 class="h3">Pending Resignation Tickets</h1><p class="text-muted small">The date on each row is the employee's <strong>last working day</strong>. They count in headcount through that day and show as Resigned from the next day.</p><table class="table"><thead><tr><th>Submitted</th><th>Employee</th><th>Requester</th><th>Workshop</th><th>Decision</th></tr></thead><tbody>@foreach(var t in Model.Tickets){<tr><td>@t.SubmittedAtUtc.ToLocalTime()</td><td>@t.Employee?.EmployeeId - @t.Employee?.FullName</td><td>@t.RequesterEmployeeId / @t.RequesterShift</td><td>@t.Workshop?.Name</td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@t.Id"/><input class="form-control" type="date" name="effectiveDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" title="Last working day" aria-label="Last working day"/><button class="btn btn-success btn-sm" name="decision" value="approve">Approve</button><button class="btn btn-outline-danger btn-sm" name="decision" value="reject">Reject</button></form></td></tr>}</tbody></table>
